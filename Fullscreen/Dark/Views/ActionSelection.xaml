<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <ResourceDictionary.MergedDictionaries>
  <ResourceDictionary Source="{ThemeFile 'DerivedStyles/TrixieSharedFilterStyles.xaml'}"/>
 </ResourceDictionary.MergedDictionaries>
 <!-- Adaptado de los tres recursos ActionSelection de Duk FST v2.0. -->
 <Style x:Key="ActionSelectionButton" TargetType="ButtonEx" BasedOn="{StaticResource TrixieFilterActionSurface}">
  <Setter Property="Margin" Value="8,4"/>
  <Setter Property="Height" Value="48"/>
  <Setter Property="FontSize" Value="18"/>
  <Setter Property="Foreground" Value="#F2F5F7"/>
  <Setter Property="HorizontalContentAlignment" Value="Left"/>
 </Style>
 <Style x:Key="ActionSelectionBorder" TargetType="Border">
  <Setter Property="CornerRadius" Value="5"/>
  <Setter Property="MinWidth" Value="430"/>
  <Setter Property="Background" Value="#303741"/>
  <Setter Property="BorderBrush" Value="#43BFEF"/>
  <Setter Property="BorderThickness" Value="2"/>
  <Setter Property="Padding" Value="8"/>
 </Style>
 <Style x:Key="ActionSelectionHeaderText" TargetType="TextBlock" BasedOn="{StaticResource TextBlockBaseStyle}">
  <Setter Property="Foreground" Value="#F2F5F7"/>
  <Setter Property="Background" Value="#394B59"/>
  <Setter Property="VerticalAlignment" Value="Bottom"/>
  <Setter Property="HorizontalAlignment" Value="Stretch"/>
  <Setter Property="TextWrapping" Value="Wrap"/>
  <Setter Property="Padding" Value="15,12"/>
 </Style>
</ResourceDictionary>