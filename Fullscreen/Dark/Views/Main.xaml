<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

 <ResourceDictionary.MergedDictionaries>
  <ResourceDictionary Source="{ThemeFile 'Views/GameDetails.xaml'}"/>
  <ResourceDictionary Source="{ThemeFile 'DefaultControls/Button.xaml'}"/>
  <ResourceDictionary Source="{ThemeFile 'DerivedStyles/ListGameItemTemplate.xaml'}"/>
  <ResourceDictionary Source="{ThemeFile 'DerivedStyles/ListGameItemStyle.xaml'}"/>
  <ResourceDictionary Source="{ThemeFile 'CustomControls/FilterPresetSelector.xaml'}"/>
  <ResourceDictionary Source="{ThemeFile 'Views/MainMenu.xaml'}"/>
  <ResourceDictionary Source="{ThemeFile 'Views/FiltersView.xaml'}"/>
  <ResourceDictionary Source="{ThemeFile 'Views/FiltersAdditional.xaml'}"/>
  <ResourceDictionary Source="{ThemeFile 'Views/ItemSelection.xaml'}"/>
  <ResourceDictionary Source="{ThemeFile 'Views/ActionSelection.xaml'}"/>
  <ResourceDictionary Source="{ThemeFile 'Views/MessageBox.xaml'}"/>
  <ResourceDictionary Source="{ThemeFile 'CustomControls/FilterDbItemtSelection.xaml'}"/>
  <ResourceDictionary Source="{ThemeFile 'CustomControls/FilterEnumListSelection.xaml'}"/>
  <ResourceDictionary Source="{ThemeFile 'CustomControls/FilterStringListSelection.xaml'}"/>
 </ResourceDictionary.MergedDictionaries>
 <!-- Prueba aislada: pincel compartido del fondo de menus superpuestos. -->
 <SolidColorBrush x:Key="OverlayMenuBackgroundBrush" Color="#303741"/>
 <!-- Diagnostico reversible: estilo implicito ButtonEx; no reemplaza ControlTemplate. -->
 <Style TargetType="{x:Type ButtonEx}" BasedOn="{StaticResource {x:Type ButtonEx}}">
  <Style.Triggers>
   <Trigger Property="IsMouseOver" Value="True">
    <Setter Property="Background" Value="#394B59"/>
    <Setter Property="Foreground" Value="#F2F5F7"/>
    <Setter Property="BorderBrush" Value="#43BFEF"/>
   </Trigger>
   <Trigger Property="IsKeyboardFocusWithin" Value="True">
    <Setter Property="Background" Value="#394B59"/>
    <Setter Property="Foreground" Value="#F2F5F7"/>
    <Setter Property="BorderBrush" Value="#43BFEF"/>
   </Trigger>
  </Style.Triggers>
 </Style>
  <ToolTip x:Key="TrixieWiiTooltipFilter" Background="#303741" Foreground="#D1E1EB" BorderBrush="#43BFEF" BorderThickness="1" Padding="10,6" FontSize="16" Content="Filtros"/>
 <ToolTip x:Key="TrixieWiiTooltipSearch" Background="#303741" Foreground="#D1E1EB" BorderBrush="#43BFEF" BorderThickness="1" Padding="10,6" FontSize="16" Content="Buscar"/>
 <ToolTip x:Key="TrixieWiiTooltipMenu" Background="#303741" Foreground="#D1E1EB" BorderBrush="#43BFEF" BorderThickness="1" Padding="10,6" FontSize="16" Content="Menú de Playnite"/>


 <!-- Estilo local: conserva ButtonEx y sus comandos, reemplaza solo su presentacion/foco. -->
 <Style x:Key="TrixieWiiBottomButton" TargetType="{x:Type ButtonEx}">
  <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
  <Setter Property="Foreground" Value="#D1E1EB"/>
  <Setter Property="Background" Value="#303741"/>
  <Setter Property="BorderBrush" Value="#43BFEF"/>
  <Setter Property="BorderThickness" Value="2"/>
  <Setter Property="Template">
   <Setter.Value>
    <ControlTemplate TargetType="{x:Type ButtonEx}">
     <Border x:Name="WiiButtonSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" SnapsToDevicePixels="True">
      <ContentPresenter ContentSource="Content" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"/>
     </Border>
     <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="WiiButtonSurface" Property="Background" Value="#394B59"/></Trigger>
      <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="WiiButtonSurface" Property="BorderBrush" Value="#21B7E9"/><Setter TargetName="WiiButtonSurface" Property="BorderThickness" Value="3"/><Setter TargetName="WiiButtonSurface" Property="Background" Value="#394B59"/></Trigger>
      <Trigger Property="IsPressed" Value="True"><Setter TargetName="WiiButtonSurface" Property="Background" Value="#476879"/></Trigger>
      <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate>
   </Setter.Value>
  </Setter>
 </Style>
 <!-- 0.4.66: controles circulares Wii, preservando los PART_ y comandos originales. -->
 <Style x:Key="TrixieWiiCircleButton" TargetType="{x:Type ButtonEx}">
  <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
  <Setter Property="Background" Value="#303741"/>
  <Setter Property="BorderBrush" Value="#50BFE3"/>
  <Setter Property="BorderThickness" Value="2"/>
  <Setter Property="Width" Value="108"/>
  <Setter Property="Height" Value="108"/>
  <Setter Property="Template"><Setter.Value>
   <ControlTemplate TargetType="{x:Type ButtonEx}">
    <Grid SnapsToDevicePixels="True">
     <Ellipse x:Name="CircleShadow" Fill="#171D22" Opacity="0.5" Margin="3,5,0,0"/>
     <Ellipse x:Name="CircleFace" Fill="{TemplateBinding Background}" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="2" Margin="3"/>
     <Ellipse Stroke="#FFFFFF" StrokeThickness="2" Opacity="0.75" Margin="9" IsHitTestVisible="False"/>
     <ContentPresenter ContentSource="Content" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"/>
    </Grid>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="CircleFace" Property="Fill" Value="#394B59"/><Setter TargetName="CircleFace" Property="Stroke" Value="#21B7E9"/></Trigger>
     <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="CircleFace" Property="StrokeThickness" Value="3"/><Setter TargetName="CircleFace" Property="Stroke" Value="#21B7E9"/><Setter TargetName="CircleFace" Property="Fill" Value="#394B59"/></Trigger>
     <Trigger Property="IsPressed" Value="True"><Setter TargetName="CircleFace" Property="Fill" Value="#476879"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate>
  </Setter.Value></Setter>
 </Style>
 <Style x:Key="TrixieWiiSearchCircleButton" TargetType="{x:Type ButtonEx}" BasedOn="{StaticResource TrixieWiiCircleButton}">
  <Setter Property="Width" Value="62"/>
  <Setter Property="Height" Value="62"/>
 </Style>
 <Style TargetType="{x:Type Main}">
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type Main}">
   <Grid x:Name="PART_MainHost" Background="#20252B">
    <Grid x:Name="PART_ViewHost">
    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="178"/></Grid.RowDefinitions>
    <!-- Biblioteca: estructura DockPanel probada en temas Fullscreen. -->
    <!-- Sin ItemsPanel propio: Playnite conserva su panel de tiles y navegacion. -->
    <DockPanel Grid.Row="0" Margin="44,24,44,16" LastChildFill="True" ClipToBounds="True" Background="#20252B">
     <DockPanel.Resources>
      <SolidColorBrush x:Key="FocusGameBorderBrush" Color="#43BFEF"/>
      <SolidColorBrush x:Key="SystemColors.HighlightBrushKey" Color="#43BFEF"/>
      <SolidColorBrush x:Key="SystemColors.HotTrackBrushKey" Color="#43BFEF"/>
      <Style TargetType="{x:Type ScrollBar}">
       <Setter Property="Foreground" Value="#36BCE8"/>
       <Setter Property="Background" Value="#E9F5FA"/>
       <Setter Property="Width" Value="14"/>
       <Setter Property="Template">
        <Setter.Value>
         <ControlTemplate TargetType="{x:Type ScrollBar}">
          <Grid Background="Transparent">
           <Border Background="#E9F5FA" CornerRadius="7" Margin="3,0"/>
           <Track x:Name="PART_Track" IsDirectionReversed="True" Focusable="False">
            <Track.DecreaseRepeatButton>
             <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
            </Track.DecreaseRepeatButton>
            <Track.Thumb>
             <Thumb Background="#36BCE8" BorderBrush="#159ECF" BorderThickness="1" Focusable="False">
              <Thumb.Template>
               <ControlTemplate TargetType="{x:Type Thumb}">
                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Margin="2,0"/>
               </ControlTemplate>
              </Thumb.Template>
             </Thumb>
            </Track.Thumb>
            <Track.IncreaseRepeatButton>
             <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
            </Track.IncreaseRepeatButton>
           </Track>
          </Grid>
         </ControlTemplate>
        </Setter.Value>
       </Setter>
      </Style>
     </DockPanel.Resources>
     <ListBoxEx FocusVisualStyle="{x:Null}" x:Name="PART_ListGameItems" Background="Transparent" BorderThickness="0"
       VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
       KeyboardNavigation.DirectionalNavigation="Once"
       VirtualizingPanel.IsVirtualizing="True"
       VirtualizingPanel.VirtualizationMode="Recycling">
       <!-- 0.6.03 experimental: doble clic sobre un canal = abrir vista de canal.
            No usa el comando PlayGame y no cambia la navegacion del mando. -->
       <ListBoxEx.InputBindings>
        <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding DataContext.ToggleGameDetailsCommand, RelativeSource={RelativeSource AncestorType={x:Type Main}}}"/>
       </ListBoxEx.InputBindings>
     </ListBoxEx>
    </DockPanel>
    <Grid Grid.Row="1" Background="#110C12">
     <Grid.RowDefinitions><RowDefinition Height="110"/><RowDefinition Height="68"/></Grid.RowDefinitions>
     <!-- 0.4.65: geometria Wii descendente, capa puramente decorativa. -->
     <!-- El Viewbox escala la curva a la anchura disponible sin alterar los PART_ de Playnite. -->
     <Grid Grid.Row="0" Background="#20252B" IsHitTestVisible="False" ClipToBounds="True">
      <Viewbox Stretch="Fill" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
       <Canvas Width="1649" Height="110">
        <!-- Zona gris por debajo de la curva: extremos altos, centro descendido. -->
        <Path Fill="#110C12" Data="M 0,3 L 140,3 C 210,3 226,20 270,61 C 294,84 311,90 360,90 L 1289,90 C 1338,90 1355,84 1379,61 C 1423,20 1439,3 1509,3 L 1649,3 L 1649,110 L 0,110 Z"/>
        <!-- Perfil celeste Wii. -->
        <Path Stroke="#50BFE3" StrokeThickness="3" StrokeLineJoin="Round" Fill="{x:Null}" Data="M 0,3 L 140,3 C 210,3 226,20 270,61 C 294,84 311,90 360,90 L 1289,90 C 1338,90 1355,84 1379,61 C 1423,20 1439,3 1509,3 L 1649,3"/>
        <!-- Separadores laterales discretos, pendientes de pulido visual. -->
        <!-- Sustituido por contornos completos en la capa decorativa 0.4.67. -->
       </Canvas>
      </Viewbox>
     </Grid>
     <Grid Grid.Row="0" Margin="34,0"><Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions>
      <!-- Zona izquierda reservada para futuros canales; sin Logros/Amigos. -->
      <Border Background="Transparent"/>
      <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"><ContentControl Content=" " ContentTemplate="{DynamicResource ButtonPromptLB}" Focusable="False" IsTabStop="False" Width="32" Height="32" Margin="0,0,32,0" VerticalAlignment="Center"/><FilterPresetSelector x:Name="PART_FilterPresetSelector" Width="220" Height="94" ClipToBounds="True" VerticalAlignment="Center" /><ContentControl Content=" " ContentTemplate="{DynamicResource ButtonPromptRB}" Focusable="False" IsTabStop="False" Width="32" Height="32" Margin="32,0,0,0" VerticalAlignment="Center"/></StackPanel>
      <Border Grid.Column="2" Background="Transparent"/>
     </Grid>
     <!-- 0.4.73: contornos laterales completos dentro del Canvas, separados de los anillos. -->
     <!-- Curvas inferiores terminan dentro del Canvas y no cruzan los botones. -->
     <Grid Grid.Row="0" Grid.RowSpan="2" IsHitTestVisible="False" ClipToBounds="True" Panel.ZIndex="1">
      <Viewbox Stretch="Fill" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
       <Canvas Width="1649" Height="204">
        <Path Stroke="#647888" StrokeThickness="3" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="{x:Null}" Data="M 0,35 L 63,35 C 106,35 144,69 144,112 C 144,159 115,193 72,193 L 0,193"/>
        <Path Stroke="#647888" StrokeThickness="3" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="{x:Null}" Data="M 1649,35 L 1586,35 C 1543,35 1505,69 1505,112 C 1505,159 1534,193 1577,193 L 1649,193"/>
       </Canvas>
      </Viewbox>
     </Grid>
     <!-- 0.4.68: contornos locales anclados a cada boton; sin geometria estirada. -->
     <!-- Los botones se dibujan sobre el relieve lateral, sin modificar el selector central. -->
     <Grid Grid.Row="1" Margin="28,-62,28,0" Panel.ZIndex="2">
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Grid Grid.Column="0" Width="128" Height="128" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-10,-10,0,0">
       <Ellipse Stroke="#647888" StrokeThickness="3" Fill="{x:Null}" Margin="1" IsHitTestVisible="False"/>
       <ButtonEx x:Name="PART_ButtonFilter" Style="{StaticResource TrixieWiiCircleButton}" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="16" ToolTip="{StaticResource TrixieWiiTooltipFilter}">
       <Viewbox Width="48" Height="48" Stretch="Uniform">
        <Path Fill="#50BFE3" Data="M 2,4 L 42,4 C 45,4 46,7 44,10 L 29,27 L 29,42 C 29,44 27,45 25,44 L 18,39 C 17,38 17,37 17,35 L 17,27 L 2,10 C 0,7 0,4 2,4 Z"/>
       </Viewbox>
       </ButtonEx>
      </Grid>
      <ButtonEx Grid.Column="1" x:Name="PART_ButtonSearch" Style="{StaticResource TrixieWiiSearchCircleButton}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="28,35,0,0" Padding="12" ToolTip="{StaticResource TrixieWiiTooltipSearch}">
       <Viewbox Width="36" Height="36" Stretch="Uniform">
        <Canvas Width="42" Height="42"><Ellipse Canvas.Left="4" Canvas.Top="3" Width="25" Height="25" Stroke="#50BFE3" StrokeThickness="5"/><Path Stroke="#50BFE3" StrokeThickness="5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M 25,26 L 39,40"/></Canvas>
       </Viewbox>
      </ButtonEx>
      <!-- 0.4.75: reloj nativo de Playnite, actualizado por la propia aplicacion. -->
      <TextBlock Grid.Column="0" Grid.ColumnSpan="4" Panel.ZIndex="3" x:Name="PART_TextClock" FontSize="38" FontWeight="SemiBold" Foreground="#F2F5F7" HorizontalAlignment="Center" VerticalAlignment="Bottom" TextAlignment="Center" Margin="0,0,0,1" IsHitTestVisible="False"/>
      <Grid Grid.Column="3" Width="128" Height="128" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-10,-10,0">
       <Ellipse Stroke="#647888" StrokeThickness="3" Fill="{x:Null}" Margin="1" IsHitTestVisible="False"/>
       <ButtonEx x:Name="PART_ButtonMainMenu" Style="{StaticResource TrixieWiiCircleButton}" Command="{Binding OpenMainMenuCommand}" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="16" ToolTip="{StaticResource TrixieWiiTooltipMenu}">
       <Image Source="{ThemeFile 'Images/WiiMenuController.png'}" Width="57" Height="57" Stretch="Uniform"/>
       <ButtonEx.Triggers><EventTrigger RoutedEvent="Button.Click"><BeginStoryboard HandoffBehavior="SnapshotAndReplace"><Storyboard><MediaTimeline Source="{ThemeFile 'audio/_menu-open.wav'}" Storyboard.TargetName="TrixieMainMenuOpeningSound"/></Storyboard></BeginStoryboard></EventTrigger></ButtonEx.Triggers></ButtonEx>
      </Grid>
     </Grid>
    </Grid>
    <Filters x:Name="PART_ElemFilters" Panel.ZIndex="5" HorizontalAlignment="Left" Width="460" Visibility="Collapsed"/>
    <FiltersAdditional x:Name="PART_ElemFiltersAdditional" Panel.ZIndex="6" HorizontalAlignment="Left" Width="460" Visibility="Collapsed"/>
    <ContentControl x:Name="PART_ContentFilterItems" Panel.ZIndex="7" HorizontalAlignment="Left" Width="460" Visibility="Collapsed"/>
    <!-- 0.5.02: host real de Playnite para mostrar la vista de cada juego. -->
    <GameDetails x:Name="PART_ElemGameDetails" Grid.RowSpan="2" Panel.ZIndex="20" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
    <!-- 0.7.19: sonido de entrada a Fullscreen, aislado del audio de navegacion. -->
    <MediaElement x:Name="TrixieStartupSound" LoadedBehavior="Manual" UnloadedBehavior="Close"
                  Volume="{Settings Fullscreen.InterfaceVolume}" Width="0" Height="0"
                  IsHitTestVisible="False" Focusable="False" Panel.ZIndex="-1"/>
    <!-- 0.7.20: musica ambiental del menu; se silencia al mostrar detalles. -->
    <MediaElement x:Name="TrixieWiiMenuMusic" LoadedBehavior="Manual" UnloadedBehavior="Close"
                  Volume="{Settings Fullscreen.InterfaceVolume}" Width="0" Height="0"
                  IsHitTestVisible="False" Focusable="False" Panel.ZIndex="-1"/>
    <!-- 0.7.11: reproductor para el boton principal del menu. -->
    <MediaElement x:Name="TrixieMainMenuOpeningSound" LoadedBehavior="Manual" UnloadedBehavior="Close" Volume="{Settings Fullscreen.InterfaceVolume}" Width="0" Height="0" IsHitTestVisible="False" Focusable="False" Panel.ZIndex="-1"/>
    <!-- 0.7.08: reproductor de cierre en Main, fuera del control GameDetails. -->
    <MediaElement x:Name="TrixieChannelClosingSound" LoadedBehavior="Manual" UnloadedBehavior="Close"
                  Volume="{Settings Fullscreen.InterfaceVolume}" Width="0" Height="0"
                  IsHitTestVisible="False" Focusable="False" Panel.ZIndex="-1"/>
    </Grid>
   </Grid>
  <ControlTemplate.Triggers>
   <!-- 0.7.19: disparo unico al cargar el control principal. -->
   <EventTrigger RoutedEvent="FrameworkElement.Loaded">
    <BeginStoryboard HandoffBehavior="SnapshotAndReplace">
     <Storyboard>
      <MediaTimeline Source="{ThemeFile 'audio/_startup-wii.mp3'}" Storyboard.TargetName="TrixieStartupSound"/>
      <!-- El inicio dura 3.239 s. Dejar un margen para evitar superposicion. -->
      <MediaTimeline Source="{ThemeFile 'audio/_wii-menu.mp3'}"
                     Storyboard.TargetName="TrixieWiiMenuMusic"
                     BeginTime="0:0:3.5" RepeatBehavior="Forever"/>
     </Storyboard>
    </BeginStoryboard>
   </EventTrigger>
   <!-- 0.7.20: evitar musica del menu mientras los detalles estan visibles. -->
   <Trigger SourceName="PART_ElemGameDetails" Property="IsVisible" Value="True">
    <Setter TargetName="TrixieWiiMenuMusic" Property="IsMuted" Value="True"/>
   </Trigger>
   <!-- 0.7.08: al abandonar GameDetails, reproducir el audio desde Main. -->
   <Trigger SourceName="PART_ElemGameDetails" Property="IsVisible" Value="True">
    <Trigger.ExitActions>
     <BeginStoryboard HandoffBehavior="SnapshotAndReplace">
      <Storyboard>
       <MediaTimeline Source="{ThemeFile 'audio/_channel-out.wav'}"
                      Storyboard.TargetName="TrixieChannelClosingSound"/>
      </Storyboard>
     </BeginStoryboard>
    </Trigger.ExitActions>
   </Trigger>
  </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
</ResourceDictionary>