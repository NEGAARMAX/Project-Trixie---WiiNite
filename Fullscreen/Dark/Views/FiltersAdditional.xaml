<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Style TargetType="{x:Type FiltersAdditional}">
 <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type FiltersAdditional}">
  <DockPanel x:Name="PART_MenuHost" Width="460" Background="#303741" LastChildFill="True">
   <DockPanel.Resources>
 <Style x:Key="TrixieSubmenuButton" TargetType="ButtonEx">
  <Setter Property="Foreground" Value="#F2F5F7"/><Setter Property="Background" Value="#303741"/>
  <Setter Property="BorderBrush" Value="#526C7D"/><Setter Property="BorderThickness" Value="1"/>
  <Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="Height" Value="48"/>
  <Setter Property="Margin" Value="12,5"/><Setter Property="Padding" Value="12,5"/>
  <Setter Property="FontSize" Value="18"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ButtonEx">
   <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
    <ContentPresenter ContentSource="Content" RecognizesAccessKey="True" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" TextElement.Foreground="{TemplateBinding Foreground}"/>
   </Border>
   <ControlTemplate.Triggers>
    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#394B59"/></Trigger>
    <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Surface" Property="Background" Value="#394B59"/><Setter TargetName="Surface" Property="BorderBrush" Value="#43BFEF"/><Setter TargetName="Surface" Property="BorderThickness" Value="3"/></Trigger>
    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.6"/></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <!-- Beta 0.4.27: scrollbar local, sin estados naranjas heredados. -->
 <Style TargetType="{x:Type ScrollBar}">
  <Setter Property="Foreground" Value="#36BCE8"/>
  <Setter Property="Background" Value="#303741"/>
  <Setter Property="Width" Value="14"/>
  <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
  <Setter Property="Template"><Setter.Value>
   <ControlTemplate TargetType="{x:Type ScrollBar}">
    <Grid Background="Transparent">
     <Border Background="#303741" CornerRadius="7" Margin="3,0"/>
     <Track x:Name="PART_Track" IsDirectionReversed="True" Focusable="False">
      <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/></Track.DecreaseRepeatButton>
      <Track.Thumb>
       <Thumb Focusable="False" Background="#36BCE8" BorderBrush="#159ECF" BorderThickness="1">
        <Thumb.Template><ControlTemplate TargetType="{x:Type Thumb}">
         <Border x:Name="TrixieThumb" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Margin="2,0"/>
         <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TrixieThumb" Property="Background" Value="#43BFEF"/><Setter TargetName="TrixieThumb" Property="BorderBrush" Value="#168FBF"/></Trigger>
          <Trigger Property="IsDragging" Value="True"><Setter TargetName="TrixieThumb" Property="Background" Value="#159ECF"/></Trigger>
         </ControlTemplate.Triggers>
        </ControlTemplate></Thumb.Template>
       </Thumb>
      </Track.Thumb>
      <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/></Track.IncreaseRepeatButton>
     </Track>
    </Grid>
   </ControlTemplate>
  </Setter.Value></Setter>
 </Style>
</DockPanel.Resources>
   <ButtonEx x:Name="PART_ButtonBack" DockPanel.Dock="Top" Style="{StaticResource TrixieSubmenuButton}" HorizontalContentAlignment="Left">
    <StackPanel Orientation="Horizontal"><TextBlock Text="‹" FontSize="27" Foreground="#249FC6" Margin="0,0,12,0"/><TextBlock Text="{DynamicResource LOCFilters}" VerticalAlignment="Center"/></StackPanel>
   </ButtonEx>
   <ItemsControlEx x:Name="PART_ItemsHost" Focusable="False" KeyboardNavigation.DirectionalNavigation="Once"/>
  </DockPanel>
 </ControlTemplate></Setter.Value></Setter>
 </Style></ResourceDictionary>