<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <!-- Experimental: Wii base button focus; adapted structurally from Duk FST v2.0. -->
 <Style TargetType="{x:Type Button}">
  <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
  <Setter Property="FontSize" Value="18"/>
  <Setter Property="Foreground" Value="#19364C"/>
  <Setter Property="Background" Value="#F8FAFC"/>
  <Setter Property="BorderBrush" Value="#43BFEF"/>
  <Setter Property="BorderThickness" Value="1"/>
  <Setter Property="HorizontalContentAlignment" Value="Center"/>
  <Setter Property="VerticalContentAlignment" Value="Center"/>
  <Setter Property="Template">
   <Setter.Value>
    <ControlTemplate TargetType="{x:Type Button}">
     <Grid Background="Transparent" SnapsToDevicePixels="True">
      <Border x:Name="MainBorder" BorderBrush="#43BFEF" BorderThickness="2" CornerRadius="5" Visibility="Collapsed"/>
      <Border x:Name="SubBorder" Margin="3" BorderBrush="#A7D9EB" BorderThickness="1" CornerRadius="3" Visibility="Collapsed"/>
      <Border x:Name="StandardBorder" Margin="1" Background="{TemplateBinding Background}"
              BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
       <ContentPresenter ContentSource="Content" RecognizesAccessKey="True"
          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
          Margin="{TemplateBinding Padding}"/>
      </Border>
     </Grid>
     <ControlTemplate.Triggers>
      <Trigger Property="IsFocused" Value="True">
       <Setter TargetName="MainBorder" Property="Visibility" Value="Visible"/>
       <Setter TargetName="SubBorder" Property="Visibility" Value="Visible"/>
       <Setter TargetName="StandardBorder" Property="Background" Value="#DDF3FC"/>
      </Trigger>
      <Trigger Property="IsMouseOver" Value="True">
       <Setter TargetName="StandardBorder" Property="Background" Value="#E8F8FD"/>
       <Setter TargetName="StandardBorder" Property="BorderBrush" Value="#43BFEF"/>
      </Trigger>
      <Trigger Property="IsPressed" Value="True">
       <Setter TargetName="StandardBorder" Property="Background" Value="#C7EAF8"/>
      </Trigger>
      <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.55"/></Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate>
   </Setter.Value>
  </Setter>
 </Style>
 <Style TargetType="{x:Type ButtonEx}" BasedOn="{StaticResource {x:Type Button}}"/>
</ResourceDictionary>