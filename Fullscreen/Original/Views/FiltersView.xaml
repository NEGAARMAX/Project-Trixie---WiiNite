<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <!-- Beta 0.4.25: casillas del panel principal y barras de combos Wii, sin alterar los comandos. -->
 <Style x:Key="FilterPanelText" TargetType="TextBlock" BasedOn="{StaticResource TextBlockBaseStyle}">
  <Setter Property="Margin" Value="20,14,12,5"/><Setter Property="FontWeight" Value="SemiBold"/>
  <Setter Property="FontSize" Value="19"/><Setter Property="Foreground" Value="#287E9F"/>
 </Style>
 <Style x:Key="FilterPanelNagivationButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
  <Setter Property="Height" Value="54"/><Setter Property="FontSize" Value="18"/><Setter Property="Padding" Value="16,8"/>
  <Setter Property="Background" Value="#F8FAFC"/><Setter Property="Foreground" Value="#287E9F"/>
  <Setter Property="BorderBrush" Value="#B6E0EF"/><Setter Property="BorderThickness" Value="0,0,0,1"/>
  <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
   <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
    <ContentPresenter ContentSource="Content" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="{TemplateBinding Padding}"/>
   </Border>
   <ControlTemplate.Triggers>
    <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Surface" Property="Background" Value="#D9F2FB"/><Setter TargetName="Surface" Property="BorderBrush" Value="#43BFEF"/><Setter TargetName="Surface" Property="BorderThickness" Value="3"/></Trigger>
    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#E2F4FB"/></Trigger>
    <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Surface" Property="Background" Value="#D9F2FB"/><Setter TargetName="Surface" Property="BorderBrush" Value="#43BFEF"/><Setter TargetName="Surface" Property="BorderThickness" Value="3"/></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>

 <!-- Plantilla Wii: foco en el propio control, sin el adorno naranja del tema base. -->
 <Style x:Key="TrixieFilterActionSurface" TargetType="ButtonEx">
  <Setter Property="Foreground" Value="#19364C"/>
  <Setter Property="Background" Value="#F8FAFC"/>
  <Setter Property="BorderBrush" Value="#A7D9EB"/>
  <Setter Property="BorderThickness" Value="1"/>
  <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
  <Setter Property="Template"><Setter.Value>
   <ControlTemplate TargetType="ButtonEx">
    <Border x:Name="TrixieActionBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" SnapsToDevicePixels="True">
     <ContentPresenter ContentSource="Content" RecognizesAccessKey="True" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="{TemplateBinding Padding}" TextElement.Foreground="{TemplateBinding Foreground}"/>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TrixieActionBorder" Property="Background" Value="#DDF3FC"/></Trigger>
     <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="TrixieActionBorder" Property="BorderBrush" Value="#43BFEF"/><Setter TargetName="TrixieActionBorder" Property="BorderThickness" Value="3"/><Setter TargetName="TrixieActionBorder" Property="Background" Value="#DDF3FC"/></Trigger>
     <Trigger Property="IsPressed" Value="True"><Setter TargetName="TrixieActionBorder" Property="Background" Value="#C7EAF8"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.65"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate>
  </Setter.Value></Setter>
 </Style>
 <Style x:Key="FilterPanelButtonEx" TargetType="ButtonEx" BasedOn="{StaticResource TrixieFilterActionSurface}">
  <Setter Property="Margin" Value="12,5"/><Setter Property="MinHeight" Value="50"/><Setter Property="FontSize" Value="18"/>
 </Style>
 <Style x:Key="FilterPanelFilterPresetActionButton" TargetType="ButtonEx" BasedOn="{StaticResource TrixieFilterActionSurface}">
  <Setter Property="Margin" Value="8,5"/><Setter Property="MinHeight" Value="48"/><Setter Property="FontSize" Value="18"/>
 </Style>
 <Style x:Key="FilterPanelCheckBoxEx" TargetType="CheckBoxEx" BasedOn="{StaticResource {x:Type CheckBoxEx}}">
  <Setter Property="Margin" Value="7,3"/><Setter Property="MinHeight" Value="48"/><Setter Property="FontSize" Value="18"/>
  <Setter Property="Foreground" Value="#19364C"/><Setter Property="Background" Value="#F8FAFC"/>
  <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBoxEx">
   <Border x:Name="RowSurface" Background="#F8FAFC" BorderBrush="Transparent" BorderThickness="2" Padding="8,3" CornerRadius="4">
    <DockPanel LastChildFill="True" TextElement.Foreground="#19364C">
     <Border x:Name="CheckSquare" DockPanel.Dock="Left" Width="21" Height="21" CornerRadius="2" Background="#FFFFFF" BorderBrush="#43BFEF" BorderThickness="2" Margin="0,0,12,0">
      <TextBlock x:Name="CheckTick" Text="✓" FontSize="17" FontWeight="Bold" Foreground="#168FC1" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
     </Border>
     <ContentPresenter ContentSource="Content" RecognizesAccessKey="True" VerticalAlignment="Center" TextElement.Foreground="#19364C"/>
    </DockPanel>
   </Border>
   <ControlTemplate.Triggers>
    <Trigger Property="IsChecked" Value="True"><Setter TargetName="CheckTick" Property="Visibility" Value="Visible"/><Setter TargetName="CheckSquare" Property="Background" Value="#E2F7FE"/></Trigger>
    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="RowSurface" Property="Background" Value="#EAF7FC"/></Trigger>
    <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="RowSurface" Property="BorderBrush" Value="#43BFEF"/><Setter TargetName="RowSurface" Property="Background" Value="#DFF3FB"/></Trigger>
    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="RowSurface" Property="Opacity" Value="0.65"/></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="FilterItemtSelectionStyle" TargetType="CheckBoxEx" BasedOn="{StaticResource {x:Type CheckBoxEx}}">
  <Setter Property="Margin" Value="12,3"/><Setter Property="MinHeight" Value="48"/><Setter Property="FontSize" Value="18"/>
  <Setter Property="Foreground" Value="#19364C"/><Setter Property="Background" Value="#F8FAFC"/>
  <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBoxEx">
   <Border x:Name="ItemSurface" Background="#F8FAFC" BorderBrush="#C7E7F2" BorderThickness="1" CornerRadius="4" Padding="7,4">
    <DockPanel LastChildFill="True" TextElement.Foreground="#19364C">
     <Border Width="22" Height="22" Background="#FFFFFF" BorderBrush="#54B6DA" BorderThickness="1" Margin="0,0,12,0" DockPanel.Dock="Left" CornerRadius="2">
      <TextBlock x:Name="Tick" Text="✓" Foreground="#60D1F5" FontSize="17" FontWeight="Bold" TextAlignment="Center" Visibility="Collapsed"/>
     </Border>
     <ContentPresenter ContentSource="Content" VerticalAlignment="Center" TextElement.Foreground="#19364C" RecognizesAccessKey="True"/>
    </DockPanel>
   </Border>
   <ControlTemplate.Triggers>
    <Trigger Property="IsChecked" Value="True"><Setter TargetName="Tick" Property="Visibility" Value="Visible"/></Trigger>
    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ItemSurface" Property="Background" Value="#E2F4FB"/></Trigger>
    <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="ItemSurface" Property="BorderBrush" Value="#43BFEF"/><Setter TargetName="ItemSurface" Property="BorderThickness" Value="2"/><Setter TargetName="ItemSurface" Property="Background" Value="#DFF3FB"/></Trigger>
    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ItemSurface" Property="Opacity" Value="0.75"/></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="TrixieFilterItemContent" TargetType="ContentPresenter">
  <Setter Property="TextElement.Foreground" Value="#19364C"/>
 </Style>
 <Style x:Key="FilterPanelComboBoxEx" TargetType="ComboBoxEx" BasedOn="{StaticResource {x:Type ComboBoxEx}}">
  <Setter Property="Margin" Value="16,3"/>
  <Setter Property="MinHeight" Value="50"/>
  <Setter Property="FontSize" Value="18"/>
  <Setter Property="Foreground" Value="#19364C"/>
  <Setter Property="Background" Value="#F8FAFC"/>
  <Setter Property="BorderBrush" Value="#78D2ED"/>
  <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
  <Setter Property="Template">
   <Setter.Value>
    <ControlTemplate TargetType="ComboBoxEx">
     <Grid SnapsToDevicePixels="True">
      <Border x:Name="ComboSurface" Background="#F8FAFC" BorderBrush="#78D2ED" BorderThickness="1" CornerRadius="4"/>
      <ToggleButton x:Name="DropDownToggle" Focusable="False" Background="Transparent" BorderThickness="0"
                    IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
       <ToggleButton.Template>
        <ControlTemplate TargetType="ToggleButton"><Border Background="Transparent"/></ControlTemplate>
       </ToggleButton.Template>
      </ToggleButton>
      <Grid Margin="14,0,12,0" IsHitTestVisible="False">
       <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/></Grid.ColumnDefinitions>
       <ContentPresenter Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Left"
                         Content="{TemplateBinding SelectionBoxItem}"
                         ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                         ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                         TextElement.Foreground="#19364C"/>
       <Path Grid.Column="1" Data="M 2 5 L 7 10 L 12 5" Stroke="#19364C" StrokeThickness="2"
             StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Grid>
      <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}"
             AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
       <Grid MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
        <Border Background="#F4FAFD" BorderBrush="#43BFEF" BorderThickness="1" CornerRadius="3">
         <ScrollViewer Margin="2" CanContentScroll="True" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
          <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
         </ScrollViewer>
        </Border>
       </Grid>
      </Popup>
     </Grid>
     <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ComboSurface" Property="Background" Value="#E8F5FB"/></Trigger>
      <Trigger Property="IsKeyboardFocusWithin" Value="True">
       <Setter TargetName="ComboSurface" Property="BorderBrush" Value="#43BFEF"/>
       <Setter TargetName="ComboSurface" Property="BorderThickness" Value="3"/>
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
       <Setter TargetName="ComboSurface" Property="Background" Value="#EDF1F4"/>
       <Setter Property="Foreground" Value="#19364C"/>
       <Setter Property="Opacity" Value="1"/>
      </Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate>
   </Setter.Value>
  </Setter>
  <Style.Resources>
   <Style TargetType="ScrollBar">
    <Setter Property="Width" Value="12"/>
    <Setter Property="Foreground" Value="#36BCE8"/>
    <Setter Property="Background" Value="#E9F5FA"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
     <Grid Background="#E9F5FA">
      <Track x:Name="PART_Track" IsDirectionReversed="True" Focusable="False">
       <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/></Track.DecreaseRepeatButton>
       <Track.Thumb><Thumb Focusable="False"><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="#36BCE8" BorderBrush="#159ECF" BorderThickness="1" CornerRadius="5" Margin="2,0"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
       <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/></Track.IncreaseRepeatButton>
      </Track>
     </Grid>
    </ControlTemplate></Setter.Value></Setter>
   </Style>
   <Style TargetType="ComboBoxItem">
    <Setter Property="Foreground" Value="#19364C"/>
    <Setter Property="FontSize" Value="18"/>
    <Setter Property="Padding" Value="12,9"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
     <Setter.Value><ControlTemplate TargetType="ComboBoxItem">
      <Border x:Name="ItemBackground" Background="#F4FAFD" Padding="{TemplateBinding Padding}">
       <ContentPresenter ContentSource="Content" VerticalAlignment="Center" TextElement.Foreground="#19364C"/>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemBackground" Property="Background" Value="#D8F1FB"/></Trigger>
       <Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemBackground" Property="BorderBrush" Value="#43BFEF"/><Setter TargetName="ItemBackground" Property="BorderThickness" Value="2,0,0,0"/></Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate></Setter.Value>
    </Setter>
   </Style>
  </Style.Resources>
 </Style>
 <DataTemplate x:Key="FilterPanelAddPresetTemplate"><TextBlock Text="+" FontSize="22" Foreground="#299EC6" HorizontalAlignment="Center"/></DataTemplate>
 <DataTemplate x:Key="FilterPanelRenamePresetTemplate"><TextBlock Text="✎" FontSize="21" Foreground="#299EC6" HorizontalAlignment="Center"/></DataTemplate>
 <DataTemplate x:Key="FilterPanelRemovePresetTemplate"><TextBlock Text="×" FontSize="23" Foreground="#299EC6" HorizontalAlignment="Center"/></DataTemplate>
 <Style TargetType="{x:Type Filters}">
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type Filters}">
   <Border Background="#F8FAFC" BorderBrush="#43BFEF" BorderThickness="0,0,2,0" Width="460" SnapsToDevicePixels="True">
    <ItemsControlEx x:Name="PART_ItemsHost" Focusable="False" KeyboardNavigation.DirectionalNavigation="Once">
     <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
     <ItemsControl.Template><ControlTemplate TargetType="ItemsControlEx">
      <ScrollViewer Focusable="False" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" CanContentScroll="True"><ItemsPresenter/></ScrollViewer>
     </ControlTemplate></ItemsControl.Template>
    </ItemsControlEx>
   </Border>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
</ResourceDictionary>