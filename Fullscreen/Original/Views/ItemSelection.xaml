<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="{ThemeFile 'DerivedStyles/TrixieSharedFilterStyles.xaml'}"/></ResourceDictionary.MergedDictionaries>


 <Style x:Key="ItemSelectionButton" TargetType="ButtonEx" BasedOn="{StaticResource TrixieFilterActionSurface}">
  <Setter Property="Margin" Value="12,5"/><Setter Property="Height" Value="48"/><Setter Property="FontSize" Value="18"/><Setter Property="HorizontalContentAlignment" Value="Left"/>
 </Style>
 <Style x:Key="ItemSelectionCheckBox" TargetType="CheckBoxEx" BasedOn="{StaticResource FilterItemtSelectionStyle}">
  <Setter Property="Margin" Value="8,3"/>
  <Setter Property="ContentTemplate"><Setter.Value><DataTemplate><TextBlock Text="{Binding}" Foreground="#19364C" FontSize="18" TextTrimming="CharacterEllipsis"/></DataTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="ItemSelectionBorder" TargetType="Border"><Setter Property="Background" Value="#F8FAFC"/><Setter Property="BorderBrush" Value="#43BFEF"/><Setter Property="BorderThickness" Value="0,0,2,0"/></Style>
 <Style x:Key="ItemSelectionFooterBorder" TargetType="Border"><Setter Property="Background" Value="#E9F5FA"/><Setter Property="Padding" Value="0,8"/></Style>
 <Style x:Key="ItemSelectionFooterButton" TargetType="ButtonEx" BasedOn="{StaticResource TrixieFilterActionSurface}">
  <Setter Property="Focusable" Value="False"/><Setter Property="Foreground" Value="#287E9F"/><Setter Property="Height" Value="45"/><Setter Property="Margin" Value="8,0"/><Setter Property="HorizontalContentAlignment" Value="Left"/>
 </Style>
 <Style x:Key="ItemSelectionHeaderText" TargetType="TextBlock" BasedOn="{StaticResource TextBlockBaseStyle}">
  <Setter Property="Foreground" Value="#19364C"/><Setter Property="Background" Value="#E2F4FB"/><Setter Property="Padding" Value="15,12"/><Setter Property="TextWrapping" Value="Wrap"/>
 </Style>
</ResourceDictionary>