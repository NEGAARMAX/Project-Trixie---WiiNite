<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <sys:Double x:Key="DetailsViewDetailsMaxWidth">1024</sys:Double>
    <sys:Boolean x:Key="DetailsViewCoverDisplayLibraryBanner">True</sys:Boolean>
    <sys:Boolean x:Key="DetailsViewAllowUseOfLogos">True</sys:Boolean>
    <sys:Boolean x:Key="DetailsViewHideGameNameIfLogoVisible">True</sys:Boolean>
    <sys:Boolean x:Key="DetailsViewLibraryGameShowFavorite">True</sys:Boolean>
    <sys:Boolean x:Key="DetailsViewHideIconInTabHeader">False</sys:Boolean>
    <sys:Boolean x:Key="DetailsViewHideTextInTabHeader">False</sys:Boolean>
    <sys:Boolean x:Key="GridViewLibraryGameShowFavorite">True</sys:Boolean>
    <sys:Boolean x:Key="GridViewCoverZoomOnHover">False</sys:Boolean>
    <Visibility x:Key="GridViewCoverSubtitleVisibility">Collapsed</Visibility>
    <Visibility x:Key="GridViewCoverCompStatusSubtitleVisibility">Collapsed</Visibility>
    <sys:Boolean x:Key="GridViewEnableCoverShineAnimation">False</sys:Boolean>
    <sys:Boolean x:Key="GridViewCoverDisplayLibraryBanner">True</sys:Boolean>
    <sys:Boolean x:Key="GridViewCoverUseRoundedCorners">True</sys:Boolean>
    <sys:Boolean x:Key="GridViewCoverDisplayDropShadowEffect">False</sys:Boolean>
    <sys:Boolean x:Key="GridViewEnablePlayingGlowBorder">True</sys:Boolean>
    <sys:Boolean x:Key="HidePlayButtonForManualGames">False</sys:Boolean>
    <sys:Boolean x:Key="DisplayLinkBar">True</sys:Boolean>
    <sys:Boolean x:Key="LinkBarAsBox">True</sys:Boolean>
    <sys:Boolean x:Key="DisableDetailsSection">False</sys:Boolean>
    <sys:Boolean x:Key="ShowPlayTimeInButtonBar">False</sys:Boolean>
    <sys:Boolean x:Key="DisplayCompletionStatusComboBox">False</sys:Boolean>
    <sys:Double x:Key="WebExplorerControlHeight">800</sys:Double>

    <sys:Double x:Key="FontSizeSmall">12</sys:Double>
    <sys:Double x:Key="FontSize">14</sys:Double>
    <sys:Double x:Key="FontSizeLarge">15</sys:Double>
    <sys:Double x:Key="FontSizeLarger">20</sys:Double>
    <sys:Double x:Key="FontSizeLargest">29</sys:Double>
    <FontFamily x:Key="FontFamily">Trebuchet MS</FontFamily>
    <FontFamily x:Key="MonospaceFontFamily">Consolas</FontFamily>
    <FontFamily x:Key="KNARZfont">./#KNARZIconFont</FontFamily>
    <Thickness x:Key="PopupBorderThickness">1</Thickness>
    <Thickness x:Key="ControlBorderThickness">1</Thickness>
    <sys:Double x:Key="EllipseBorderThickness">1</sys:Double>
    <sys:Double x:Key="ControlCornerRadiusValue">5</sys:Double>
    <CornerRadius x:Key="ControlCornerRadius"
                  BottomLeft="{StaticResource ControlCornerRadiusValue}"
                  BottomRight="{StaticResource ControlCornerRadiusValue}"
                  TopLeft="{StaticResource ControlCornerRadiusValue}"
                  TopRight="{StaticResource ControlCornerRadiusValue}" />
    <CornerRadius x:Key="ControlCornerRadiusSmall">0</CornerRadius>
    <Thickness x:Key="SidebarItemPadding">8</Thickness>
    <CornerRadius x:Key="GridViewCoverCornerRadius">5</CornerRadius>
    <CornerRadius x:Key="GridViewCoverGridBackgroundDisabledCornerRadius">5,5,0,0</CornerRadius>
    <CornerRadius x:Key="GridViewShowGameNameCornerRadius">0,0,5,5</CornerRadius>
    <CornerRadius x:Key="GridViewSelectionBorderCornerRadius">7</CornerRadius>

    <Color x:Key="BlackColor">#FF000000</Color>
    <Color x:Key="WhiteColor">#FFFFFFFF</Color>
    <Color x:Key="TextColor">#FF243D4B</Color>
    <Color x:Key="TextColorDarker">#FF657E8C</Color>
    <Color x:Key="TextColorDark">#FF24404F</Color>
    <Color x:Key="MainColor">#FFF4FAFD</Color>
    <Color x:Key="MainColorDark">#FFE8F4FA</Color>
    <Color x:Key="MainColorDarker">#FFFFFFFF</Color>
    <Color x:Key="HoverColor">#FFD9F2FF</Color>
    <Color x:Key="GlyphColor">#FF4EACD4</Color>
    <Color x:Key="HighlightGlyphColor">#FF1E8FCA</Color>
    <Color x:Key="PopupBackgroundColor">#FFFFFFFF</Color>
    <Color x:Key="PopupBorderColor">#FFB6D5E5</Color>
    <Color x:Key="BackgroundToneColor">#FF67C2E5</Color>
    <Color x:Key="GridItemBackgroundColor">#FFF5FBFF</Color>
    <Color x:Key="PanelSeparatorColor">#FFD5E7F0</Color>
    <Color x:Key="WindowPanelSeparatorColor">#FFB9D8E9</Color>
    <Color x:Key="DataChangeNotifColor">#FFFFD149</Color>
    <Color x:Key="NormalBorderControlsHoverTransparencyColor">#4c919191</Color>

    <SolidColorBrush x:Key="ControlBackgroundBrush"
                     Color="{DynamicResource MainColorDarker}" />
    <SolidColorBrush x:Key="TextBrush"
                     Color="{DynamicResource TextColor}" />
    <SolidColorBrush x:Key="TextBrushDarker"
                     Color="{DynamicResource TextColorDarker}" />
    <SolidColorBrush x:Key="TextBrushDark"
                     Color="{DynamicResource TextColorDark}" />
    <SolidColorBrush x:Key="NormalBrush"
                     Color="{DynamicResource MainColorDark}" />
    <SolidColorBrush x:Key="NormalBrushDark"
                     Color="{DynamicResource MainColorDarker}" />
    <SolidColorBrush x:Key="NormalBorderBrush"
                     Color="{DynamicResource MainColorDark}" />
    <SolidColorBrush x:Key="HoverBrush"
                     Color="{DynamicResource HoverColor}" />
    <SolidColorBrush x:Key="GlyphBrush"
                     Color="{DynamicResource GlyphColor}" />
    <SolidColorBrush x:Key="HighlightGlyphBrush"
                     Color="{DynamicResource HighlightGlyphColor}" />
    <SolidColorBrush x:Key="PopupBorderBrush"
                     Color="{DynamicResource PopupBorderColor}" />
    <SolidColorBrush x:Key="TooltipBackgroundBrush"
                     Color="{DynamicResource PopupBackgroundColor}" />
    <SolidColorBrush x:Key="ButtonBackgroundBrush"
                     Color="{DynamicResource GridItemBackgroundColor}" />
    <SolidColorBrush x:Key="GridItemBackgroundBrush"
                     Color="{DynamicResource GridItemBackgroundColor}" />
    <SolidColorBrush x:Key="PanelSeparatorBrush"
                     Color="{DynamicResource PanelSeparatorColor}" />
    <SolidColorBrush x:Key="WindowPanelSeparatorBrush"
                     Color="{DynamicResource WindowPanelSeparatorColor}" />
    <SolidColorBrush x:Key="PopupBackgroundBrush"
                     Color="{DynamicResource PopupBackgroundColor}" />
    <SolidColorBrush x:Key="CheckBoxCheckMarkBkBrush"
                     Color="{DynamicResource MainColorDark}" />

    <SolidColorBrush x:Key="PositiveRatingBrush"
                     Color="#78ffa0" />
    <SolidColorBrush x:Key="NegativeRatingBrush"
                     Color="#FFFF6250" />
    <SolidColorBrush x:Key="MixedRatingBrush"
                     Color="#FFFFD149" />
    <SolidColorBrush x:Key="WarningBrush"
                     Color="#FFFF6250" />

    <SolidColorBrush x:Key="ExpanderBackgroundBrush"
                     Color="{DynamicResource HoverColor}" />
    <SolidColorBrush x:Key="WindowBackgourndBrush"
                     Color="{DynamicResource MainColor}" />
    <SolidColorBrush x:Key="OpaqueGrayHighlightBrush"
                     Color="{DynamicResource NormalBorderControlsHoverTransparencyColor}" />

    <SolidColorBrush x:Key="OpaqueButtonBackgroundBrush"
                     Color="{DynamicResource GridItemBackgroundColor}"
                     Opacity="0.7" />
    <SolidColorBrush x:Key="OpaqueNormalBrush"
                     Color="{DynamicResource MainColorDark}"
                     Opacity="0.7" />

    <SolidColorBrush x:Key="Extras_FilledStarBrush"
                     Color="{DynamicResource HighlightGlyphColor}" />
    <SolidColorBrush x:Key="Extras_EmptyStarBrush"
                     Color="{DynamicResource HighlightGlyphColor}"
                     Opacity="0.5" />

    <SolidColorBrush x:Key="GridViewCoverSubtitleBrush"
                     Color="#b7b7b7" />

    <DropShadowEffect x:Key="DefaultDropShadow"
                      ShadowDepth="0"
                      BlurRadius="10"
                      Opacity="0.7"
                      Color="Black"
                      RenderingBias="Performance" />
    <DropShadowEffect x:Key="DefaultSubtleDropShadow"
                      ShadowDepth="0"
                      BlurRadius="6"
                      Opacity="0.5"
                      Color="Black"
                      RenderingBias="Performance" />
    <DropShadowEffect x:Key="NoDropShadow"
                      ShadowDepth="0"
                      BlurRadius="0"
                      Opacity="0"
                      Color="Transparent"
                      RenderingBias="Performance" />
</ResourceDictionary>